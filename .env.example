# Use unique random hex values. Match the passwords in the corresponding URLs.
VERITY_DB_PASSWORD=
VERITY_REDIS_PASSWORD=
DATABASE_URL=postgres://verity:REPLACE_DB_PASSWORD@127.0.0.1:55439/verity
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:56389
AI_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b-mlx
EMBEDDING_MODEL=gemini-embedding-001
# Gemini generation and embeddings use the same server-side API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# USD per million tokens for the configured model and billing tier. Use 0 for a free tier.
GEMINI_INPUT_USD_PER_MTOK=
GEMINI_OUTPUT_USD_PER_MTOK=
OPENALEX_API_KEY=
CROSSREF_MAILTO=
# Optional. Enable Google Scholar discovery through SerpApi.
SERPAPI_API_KEY=
COOKIE_SECURE=false
