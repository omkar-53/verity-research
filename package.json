{
  "name": "verity-research-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "setup": "node scripts/init.mjs",
    "evaluate": "node --env-file=.env evaluation/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "bullmq": "^6.7.8",
    "express": "^5.3.0",
    "he": "^1.2.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.0"
  }
}
